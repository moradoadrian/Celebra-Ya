---
import { SITE_CONFIG, EVENT_CATEGORIES, NAV_ITEMS } from '@/lib/constants';

const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-900 text-slate-300 pt-16 pb-12 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-slate-800">
      
      <!-- Studio Brand column -->
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-purple-500 to-indigo-500 flex items-center justify-center text-white font-bold text-lg shadow-lg shadow-purple-500/30">
            C
          </div>
          <div class="flex flex-col">
            <span class="text-xl font-extrabold tracking-tight text-white leading-none">
              Celebra<span class="text-purple-400">-Ya</span>
            </span>
            <span class="text-[9px] font-bold uppercase tracking-widest text-slate-400">Design Studio</span>
          </div>
        </a>
        <p class="text-slate-400 text-sm max-w-sm leading-relaxed">
          Estudio de diseño y desarrollo web especializado en crear experiencias digitales inolvidables para bodas, XV años, bautizos y celebraciones de alto perfil.
        </p>
        <div class="flex items-center gap-3 pt-2">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-purple-950/80 text-purple-300 border border-purple-800/50">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Desarrollo Web Profesional & Dedicado
          </span>
        </div>
      </div>

      <!-- Navigation Links -->
      <div>
        <h3 class="text-xs font-semibold text-slate-200 uppercase tracking-wider mb-4">Secciones</h3>
        <ul class="space-y-2.5 text-sm">
          {
            NAV_ITEMS.map((item) => (
              <li>
                <a href={item.href} class="text-slate-400 hover:text-purple-400 transition-colors">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Categories -->
      <div>
        <h3 class="text-xs font-semibold text-slate-200 uppercase tracking-wider mb-4">Especialidades</h3>
        <ul class="space-y-2.5 text-sm">
          {
            EVENT_CATEGORIES.slice(0, 5).map((cat) => (
              <li>
                <a href={`/plantillas?categoria=${cat.id}`} class="text-slate-400 hover:text-purple-400 transition-colors">
                  Invitaciones para {cat.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Legal / Contact -->
      <div>
        <h3 class="text-xs font-semibold text-slate-200 uppercase tracking-wider mb-4">Contacto Directo</h3>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/contacto" class="text-slate-400 hover:text-purple-400 transition-colors">Solicitar Cotización</a></li>
          <li><a href="/contacto" class="text-slate-400 hover:text-purple-400 transition-colors">Contacto por WhatsApp</a></li>
          <li><a href="#" class="text-slate-400 hover:text-purple-400 transition-colors">Términos del Servicio</a></li>
          <li><a href="#" class="text-slate-400 hover:text-purple-400 transition-colors">Política de Privacidad</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>© {currentYear} {SITE_CONFIG.name}. Todos los derechos reservados.</p>
      <p class="flex items-center gap-1 text-slate-400">
        Diseñado y desarrollado con pasión artesanal ✨
      </p>
    </div>
  </div>
</footer>
