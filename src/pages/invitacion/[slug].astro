---
import { TemplatesService } from '@/services/templates.service';

export const prerender = true;

export async function getStaticPaths() {
  const templates = await TemplatesService.getAllTemplates();
  return templates.map((template) => ({
    params: { slug: template.slug },
    props: { template },
  }));
}

const { slug } = Astro.params;
const { template } = Astro.props;

if (!template) {
  return Astro.redirect('/404');
}

// Redirect all invitation demo slugs to their corresponding clean demo page
if (slug === 'boda-elegancia-eterna' || slug === 'boda-sofia-alejandro') {
  return Astro.redirect('/demo/boda-sofia-alejandro');
}

// Default redirect to primary demo
return Astro.redirect('/demo/boda-sofia-alejandro');
---
