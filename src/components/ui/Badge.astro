---
export interface Props {
  variant?: 'purple' | 'gray' | 'success';
  class?: string;
}

const { variant = 'purple', class: className = '' } = Astro.props;

const variants = {
  purple: 'bg-purple-100 text-purple-700 border-purple-200',
  gray: 'bg-slate-100 text-slate-700 border-slate-200',
  success: 'bg-emerald-100 text-emerald-700 border-emerald-200',
};
---

<span class={`inline-flex items-center gap-1.5 px-3 py-1 text-xs font-semibold rounded-full border ${variants[variant]} ${className}`}>
  <slot />
</span>
