---
import type { UbicacionItem } from '@/types';

interface Props {
  ubicaciones?: UbicacionItem[];
}

const { ubicaciones = [] } = Astro.props;

const getLocationStyle = (tipo: string, index: number) => {
  const t = (tipo || '').toLowerCase();
  if (t.includes('ceremonia') || t.includes('iglesia') || t.includes('religiosa')) {
    return {
      icon: '⛪',
      iconBg: 'bg-rose-100 text-rose-700',
      badgeClass: 'text-rose-700'
    };
  }
  if (t.includes('recep') || t.includes('fiesta') || t.includes('salon') || t.includes('jardin')) {
    return {
      icon: '🏰',
      iconBg: 'bg-amber-100 text-amber-800',
      badgeClass: 'text-amber-800'
    };
  }
  if (index % 2 === 0) {
    return {
      icon: '⛪',
      iconBg: 'bg-rose-100 text-rose-700',
      badgeClass: 'text-rose-700'
    };
  }
  return {
    icon: '🏰',
    iconBg: 'bg-amber-100 text-amber-800',
    badgeClass: 'text-amber-800'
  };
};
---

{ubicaciones && ubicaciones.length > 0 && (
  <section class="py-24 bg-white border-y border-stone-200/60 px-4">
    <div class="max-w-5xl mx-auto space-y-16">
      <div class="text-center space-y-3">
        <span class="text-xs uppercase tracking-[0.3em] text-rose-700 font-semibold">Ubicaciones</span>
        <h2 class="text-3xl sm:text-5xl font-serif-luxury text-stone-900">
          ¿Cómo Llegar?
        </h2>
        <p class="text-xs text-stone-500 font-sans-clean">Te compartimos las ubicaciones con enlace directo a tu app de mapas preferida.</p>
      </div>

      <div class={`grid grid-cols-1 ${ubicaciones.length > 1 ? 'md:grid-cols-2' : 'max-w-xl mx-auto'} gap-8`}>
        {ubicaciones.map((item, index) => {
          const style = getLocationStyle(item.tipo, index);
          const hasGoogleMaps = Boolean(item.google_maps && item.google_maps.trim() !== '');
          const hasWaze = Boolean(item.waze && item.waze.trim() !== '');

          return (
            <div class="bg-[#faf8f5] p-8 rounded-3xl border border-stone-200 space-y-6 flex flex-col justify-between">
              <div class="space-y-4">
                <div class={`w-12 h-12 rounded-full ${style.iconBg} flex items-center justify-center text-xl font-serif`}>
                  {style.icon}
                </div>
                <div>
                  <span class={`text-xs font-semibold uppercase tracking-wider ${style.badgeClass}`}>{item.tipo}</span>
                  <h3 class="text-2xl font-serif-luxury font-bold text-stone-900 mt-1">{item.nombre}</h3>
                  <p class="text-xs text-stone-600 mt-2 font-sans-clean">
                    {item.direccion}
                  </p>
                  {item.hora && <p class="text-xs font-mono text-stone-500 mt-1">Hora: {item.hora}</p>}
                </div>
              </div>

              {(hasGoogleMaps || hasWaze) && (
                <div class="flex gap-3 pt-4 border-t border-stone-200/80">
                  {hasGoogleMaps && (
                    <a
                      href={item.google_maps}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex-1 py-3 px-4 rounded-xl bg-white hover:bg-stone-50 text-stone-900 border border-stone-300 font-semibold text-xs text-center transition-all shadow-xs"
                    >
                      📍 Abrir Google Maps
                    </a>
                  )}
                  {hasWaze && (
                    <a
                      href={item.waze}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex-1 py-3 px-4 rounded-xl bg-cyan-600 hover:bg-cyan-700 text-white font-semibold text-xs text-center transition-all shadow-xs"
                    >
                      🚙 Abrir Waze
                    </a>
                  )}
                </div>
              )}
            </div>
          );
        })}
      </div>
    </div>
  </section>
)}
