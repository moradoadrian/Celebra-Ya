---
---

<section class="py-24 bg-white border-y border-stone-200/60 px-4">
  <div class="max-w-5xl mx-auto space-y-16">
    <div class="text-center space-y-3">
      <span class="text-xs uppercase tracking-[0.3em] text-rose-700 font-semibold">Ubicaciones</span>
      <h2 class="text-3xl sm:text-5xl font-serif-luxury text-stone-900">
        ¿Cómo Llegar?
      </h2>
      <p class="text-xs text-stone-500 font-sans-clean">Te compartimos las ubicaciones con enlace directo a tu app de mapas preferida.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {/* Ubicación 1: Ceremonia */}
      <div class="bg-[#faf8f5] p-8 rounded-3xl border border-stone-200 space-y-6 flex flex-col justify-between">
        <div class="space-y-4">
          <div class="w-12 h-12 rounded-full bg-rose-100 text-rose-700 flex items-center justify-center text-xl font-serif">
            ⛪
          </div>
          <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-rose-700">Ceremonia Religiosa</span>
            <h3 class="text-2xl font-serif-luxury font-bold text-stone-900 mt-1">Parroquia de Santa Prisca</h3>
            <p class="text-xs text-stone-600 mt-2 font-sans-clean">
              Av. Universidad 125, Col. Narvarte, Ciudad de México.
            </p>
            <p class="text-xs font-mono text-stone-500 mt-1">Hora: 17:00 HRS</p>
          </div>
        </div>

        <div class="flex gap-3 pt-4 border-t border-stone-200/80">
          <a
            href="https://maps.google.com"
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 py-3 px-4 rounded-xl bg-white hover:bg-stone-50 text-stone-900 border border-stone-300 font-semibold text-xs text-center transition-all shadow-xs"
          >
            📍 Abrir Google Maps
          </a>
          <a
            href="https://waze.com"
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 py-3 px-4 rounded-xl bg-cyan-600 hover:bg-cyan-700 text-white font-semibold text-xs text-center transition-all shadow-xs"
          >
            🚙 Abrir Waze
          </a>
        </div>
      </div>

      {/* Ubicación 2: Recepción */}
      <div class="bg-[#faf8f5] p-8 rounded-3xl border border-stone-200 space-y-6 flex flex-col justify-between">
        <div class="space-y-4">
          <div class="w-12 h-12 rounded-full bg-amber-100 text-amber-800 flex items-center justify-center text-xl font-serif">
            🏰
          </div>
          <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-amber-800">Recepción & Fiesta</span>
            <h3 class="text-2xl font-serif-luxury font-bold text-stone-900 mt-1">Jardín de Eventos Las Palmas</h3>
            <p class="text-xs text-stone-600 mt-2 font-sans-clean">
              Carretera Picacho Ajusco Km 4.5, Tlalpan, Ciudad de México.
            </p>
            <p class="text-xs font-mono text-stone-500 mt-1">Hora: 18:30 HRS</p>
          </div>
        </div>

        <div class="flex gap-3 pt-4 border-t border-stone-200/80">
          <a
            href="https://maps.google.com"
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 py-3 px-4 rounded-xl bg-white hover:bg-stone-50 text-stone-900 border border-stone-300 font-semibold text-xs text-center transition-all shadow-xs"
          >
            📍 Abrir Google Maps
          </a>
          <a
            href="https://waze.com"
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 py-3 px-4 rounded-xl bg-cyan-600 hover:bg-cyan-700 text-white font-semibold text-xs text-center transition-all shadow-xs"
          >
            🚙 Abrir Waze
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
