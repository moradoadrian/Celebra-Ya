---
import type { ProgramaItem } from '@/types';

interface Props {
  eventoId: number;
  items: ProgramaItem[];
}

const { eventoId, items = [] } = Astro.props;

// Ordenar por 'orden' ascendente
const sortedItems = [...items].sort((a, b) => (a.orden ?? 0) - (b.orden ?? 0));
---

<div class="bg-white border border-stone-200/80 rounded-2xl p-6 sm:p-8 shadow-xs space-y-6" id="manager-programa">
  {/* ENCABEZADO DE SECCIÓN */}
  <div class="border-b border-stone-100 pb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div>
      <div class="flex items-center gap-2.5">
        <span class="w-8 h-8 rounded-xl bg-amber-50 border border-amber-200/80 text-amber-700 flex items-center justify-center text-sm font-bold">
          ⏰
        </span>
        <h2 class="text-base font-semibold text-stone-900">Programa del Evento</h2>
        <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-stone-100 text-stone-600 border border-stone-200/80" id="programa-counter">
          {sortedItems.length} {sortedItems.length === 1 ? 'itinerario' : 'itinerarios'}
        </span>
      </div>
      <p class="text-xs text-stone-500 mt-1">
        Define la cronología y los momentos clave del gran día (ceremonia, cóctel, cena, fiesta).
      </p>
    </div>

    <div>
      <button
        type="button"
        id="btn-add-programa"
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-stone-900 hover:bg-stone-800 text-amber-200 text-xs font-semibold tracking-wide transition-all shadow-xs cursor-pointer"
      >
        <span>+</span>
        <span>Agregar momento</span>
      </button>
    </div>
  </div>

  {/* LISTADO DE MOMENTOS */}
  <div id="programa-list" class="space-y-3">
    {sortedItems.length === 0 ? (
      <div id="programa-empty" class="text-center py-10 px-4 border-2 border-dashed border-stone-200 rounded-xl">
        <p class="text-2xl mb-2">⏳</p>
        <p class="text-xs font-semibold text-stone-700">Esta invitación todavía no tiene momentos en el programa.</p>
        <p class="text-[11px] text-stone-400 mt-0.5">Agrega el itinerario para que tus invitados conozcan el horario de las actividades.</p>
      </div>
    ) : (
      sortedItems.map((item) => (
        <div
          class="flex flex-col sm:flex-row sm:items-center justify-between p-4 rounded-xl border border-stone-200/70 bg-stone-50/50 hover:bg-white hover:border-stone-300 transition-all gap-3"
          id={`programa-row-${item.id}`}
        >
          <div class="flex items-start gap-3">
            <span class="w-7 h-7 rounded-lg bg-stone-200/70 text-stone-700 text-xs font-bold flex items-center justify-center shrink-0 border border-stone-300/80 mt-0.5" title="Orden">
              #{item.orden}
            </span>
            <div class="space-y-1">
              <div class="flex items-center gap-2">
                <span class="font-mono text-xs font-bold px-2 py-0.5 rounded-md bg-stone-900 text-amber-300 shrink-0">
                  {item.hora}
                </span>
                <h3 class="text-sm font-semibold text-stone-900">{item.titulo}</h3>
              </div>
              {item.descripcion && (
                <p class="text-xs text-stone-600">{item.descripcion}</p>
              )}
            </div>
          </div>

          <div class="flex items-center gap-2 self-end sm:self-center shrink-0">
            <button
              type="button"
              class="btn-edit-programa px-3 py-1.5 rounded-lg text-xs font-semibold text-stone-700 bg-white hover:bg-stone-100 border border-stone-200 shadow-2xs transition-colors cursor-pointer"
              data-id={item.id}
              data-hora={item.hora}
              data-titulo={item.titulo}
              data-descripcion={item.descripcion || ''}
              data-orden={item.orden}
            >
              Editar
            </button>
            <button
              type="button"
              class="btn-delete-programa px-3 py-1.5 rounded-lg text-xs font-semibold text-rose-700 bg-rose-50 hover:bg-rose-100 border border-rose-200 shadow-2xs transition-colors cursor-pointer"
              data-id={item.id}
              data-titulo={item.titulo}
            >
              Eliminar
            </button>
          </div>
        </div>
      ))
    )}
  </div>

  {/* MODAL CREAR Y EDITAR PROGRAMA */}
  <dialog id="modal-programa" class="rounded-2xl backdrop:bg-stone-900/60 p-0 border border-stone-200 shadow-2xl max-w-md w-full bg-white text-stone-800 m-auto">
    <div class="p-6 space-y-4">
      <div class="flex items-center justify-between border-b border-stone-100 pb-3">
        <h3 id="modal-programa-title" class="text-base font-semibold text-stone-900">
          Nuevo Momento del Programa
        </h3>
        <button type="button" id="btn-close-programa" class="text-stone-400 hover:text-stone-700 text-lg leading-none cursor-pointer">
          ✕
        </button>
      </div>

      <form id="form-programa" class="space-y-4">
        <input type="hidden" id="programa-id" name="id" value="" />
        <input type="hidden" name="evento_id" value={eventoId} />

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <div class="sm:col-span-2">
            <label for="programa-hora" class="block text-xs font-semibold uppercase tracking-wider text-stone-600 mb-1">
              Hora <span class="text-rose-500">*</span>
            </label>
            <input
              type="text"
              id="programa-hora"
              name="hora"
              required
              placeholder="Ej. 17:00 o 18:30"
              class="w-full px-3.5 py-2 rounded-xl border border-stone-300 focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 text-xs text-stone-900 font-mono"
            />
          </div>

          <div>
            <label for="programa-orden" class="block text-xs font-semibold uppercase tracking-wider text-stone-600 mb-1">
              Orden
            </label>
            <input
              type="number"
              id="programa-orden"
              name="orden"
              min="1"
              value={sortedItems.length + 1}
              class="w-full px-3.5 py-2 rounded-xl border border-stone-300 focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 text-xs text-stone-900 font-mono"
            />
          </div>
        </div>

        <div>
          <label for="programa-titulo" class="block text-xs font-semibold uppercase tracking-wider text-stone-600 mb-1">
            Título del momento <span class="text-rose-500">*</span>
          </label>
          <input
            type="text"
            id="programa-titulo"
            name="titulo"
            required
            placeholder="Ej. Ceremonia Religiosa, Brindis o Cena"
            class="w-full px-3.5 py-2 rounded-xl border border-stone-300 focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 text-xs text-stone-900"
          />
        </div>

        <div>
          <label for="programa-descripcion" class="block text-xs font-semibold uppercase tracking-wider text-stone-600 mb-1">
            Descripción o notas
          </label>
          <textarea
            id="programa-descripcion"
            name="descripcion"
            rows="3"
            placeholder="Ej. Acompáñanos a recibir a los novios con bengalas..."
            class="w-full px-3.5 py-2 rounded-xl border border-stone-300 focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 text-xs text-stone-900"
          ></textarea>
        </div>

        <div id="modal-programa-error" class="hidden text-xs text-rose-600 bg-rose-50 border border-rose-200 p-2.5 rounded-xl"></div>

        <div class="flex items-center justify-end gap-2 pt-3 border-t border-stone-100">
          <button
            type="button"
            id="btn-cancel-programa"
            class="px-4 py-2 rounded-xl border border-stone-300 text-stone-600 hover:bg-stone-50 text-xs font-semibold cursor-pointer"
          >
            Cancelar
          </button>
          <button
            type="submit"
            id="btn-save-programa"
            class="px-5 py-2 rounded-xl bg-stone-900 hover:bg-stone-800 text-amber-200 text-xs font-bold shadow-xs cursor-pointer"
          >
            Guardar momento
          </button>
        </div>
      </form>
    </div>
  </dialog>

  {/* MODAL DE CONFIRMACIÓN PARA ELIMINAR */}
  <dialog id="modal-confirm-delete-programa" class="rounded-2xl backdrop:bg-stone-900/60 p-0 border border-stone-200 shadow-2xl max-w-sm w-full bg-white text-stone-800 m-auto">
    <div class="p-6 text-center space-y-4">
      <div class="w-12 h-12 rounded-full bg-rose-50 text-rose-600 flex items-center justify-center text-xl mx-auto border border-rose-100">
        🗑️
      </div>
      <div>
        <h3 class="text-sm font-bold text-stone-900">¿Eliminar este momento del programa?</h3>
        <p class="text-xs text-stone-500 mt-1" id="delete-programa-name-text">
          Esta acción no se puede deshacer.
        </p>
      </div>
      <div class="flex items-center justify-center gap-3 pt-2">
        <button
          type="button"
          id="btn-cancel-delete-programa"
          class="px-4 py-2 rounded-xl border border-stone-300 text-stone-600 hover:bg-stone-50 text-xs font-semibold cursor-pointer"
        >
          Cancelar
        </button>
        <button
          type="button"
          id="btn-confirm-delete-programa"
          class="px-5 py-2 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold shadow-xs cursor-pointer"
        >
          Eliminar
        </button>
      </div>
    </div>
  </dialog>
</div>

<script is:inline define:vars={{ eventoId, totalItems: sortedItems.length }}>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('modal-programa');
    const form = document.getElementById('form-programa');
    const modalTitle = document.getElementById('modal-programa-title');
    const modalError = document.getElementById('modal-programa-error');
    const btnAdd = document.getElementById('btn-add-programa');
    const btnClose = document.getElementById('btn-close-programa');
    const btnCancel = document.getElementById('btn-cancel-programa');

    const modalDelete = document.getElementById('modal-confirm-delete-programa');
    const deleteText = document.getElementById('delete-programa-name-text');
    const btnCancelDelete = document.getElementById('btn-cancel-delete-programa');
    const btnConfirmDelete = document.getElementById('btn-confirm-delete-programa');
    let targetDeleteId = null;

    btnAdd?.addEventListener('click', () => {
      form.reset();
      document.getElementById('programa-id').value = '';
      document.getElementById('programa-orden').value = totalItems + 1;
      modalTitle.textContent = 'Nuevo Momento del Programa';
      modalError.classList.add('hidden');
      modal?.showModal();
    });

    const closeModal = () => modal?.close();
    btnClose?.addEventListener('click', closeModal);
    btnCancel?.addEventListener('click', closeModal);

    document.querySelectorAll('.btn-edit-programa').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-id');
        const hora = btn.getAttribute('data-hora');
        const titulo = btn.getAttribute('data-titulo');
        const descripcion = btn.getAttribute('data-descripcion');
        const orden = btn.getAttribute('data-orden');

        document.getElementById('programa-id').value = id;
        document.getElementById('programa-hora').value = hora || '';
        document.getElementById('programa-titulo').value = titulo || '';
        document.getElementById('programa-descripcion').value = descripcion || '';
        document.getElementById('programa-orden').value = orden || '1';

        modalTitle.textContent = 'Editar Momento';
        modalError.classList.add('hidden');
        modal?.showModal();
      });
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const saveBtn = document.getElementById('btn-save-programa');
      saveBtn.disabled = true;
      saveBtn.textContent = 'Guardando...';
      modalError.classList.add('hidden');

      const id = document.getElementById('programa-id').value;
      const action = id ? 'update' : 'create';

      const payload = {
        action,
        evento_id: eventoId,
        id: id ? Number(id) : undefined,
        hora: document.getElementById('programa-hora').value,
        titulo: document.getElementById('programa-titulo').value,
        descripcion: document.getElementById('programa-descripcion').value,
        orden: Number(document.getElementById('programa-orden').value) || 1,
      };

      try {
        const res = await fetch('/api/admin/programa', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const result = await res.json();

        if (res.ok && result.success) {
          modal?.close();
          window.location.reload();
        } else {
          modalError.textContent = result.error || 'Error al guardar el programa.';
          modalError.classList.remove('hidden');
          saveBtn.disabled = false;
          saveBtn.textContent = 'Guardar momento';
        }
      } catch (err) {
        modalError.textContent = 'Error de conexión con el servidor.';
        modalError.classList.remove('hidden');
        saveBtn.disabled = false;
        saveBtn.textContent = 'Guardar momento';
      }
    });

    document.querySelectorAll('.btn-delete-programa').forEach((btn) => {
      btn.addEventListener('click', () => {
        targetDeleteId = btn.getAttribute('data-id');
        const titulo = btn.getAttribute('data-titulo');
        deleteText.textContent = `¿Seguro que deseas eliminar "${titulo}"? Esta acción no se puede deshacer.`;
        modalDelete?.showModal();
      });
    });

    btnCancelDelete?.addEventListener('click', () => {
      targetDeleteId = null;
      modalDelete?.close();
    });

    btnConfirmDelete?.addEventListener('click', async () => {
      if (!targetDeleteId) return;
      btnConfirmDelete.disabled = true;
      btnConfirmDelete.textContent = 'Eliminando...';

      try {
        const res = await fetch('/api/admin/programa', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'delete',
            evento_id: eventoId,
            id: Number(targetDeleteId),
          }),
        });
        const result = await res.json();
        if (res.ok && result.success) {
          modalDelete?.close();
          window.location.reload();
        } else {
          alert(result.error || 'Error al eliminar.');
          btnConfirmDelete.disabled = false;
          btnConfirmDelete.textContent = 'Eliminar';
        }
      } catch (err) {
        alert('Error de conexión.');
        btnConfirmDelete.disabled = false;
        btnConfirmDelete.textContent = 'Eliminar';
      }
    });
  });
</script>
