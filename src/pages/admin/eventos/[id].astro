              name="frase_despedida"
              rows="2"
              class="w-full px-4 py-2.5 rounded-xl border border-stone-300 focus:border-amber-500 focus:ring-2 focus:ring-amber-500/20 text-stone-900 text-sm transition-all"
              placeholder="Ej. ¡Esperamos contar con tu valiosa presencia en este día tan especial!"
            >{evento.frase_despedida || ''}</textarea>
          </div>
        </div>

        {/* BOTONES DE ACCIÓN INFERIOR */}
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-4 border-t border-stone-200/80">
          <a
            href="/admin"
            class="w-full sm:w-auto inline-flex items-center justify-center px-6 py-3 rounded-xl border border-stone-300 bg-white hover:bg-stone-50 text-stone-700 text-xs font-semibold shadow-xs transition-colors"
          >
            Cancelar
          </a>

          <button
            type="submit"
            id="submit-btn"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3 rounded-xl bg-stone-900 hover:bg-stone-800 text-amber-200 text-xs font-bold tracking-wide shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <svg id="save-icon" width="14" height="14" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span id="btn-text">Guardar cambios</span>
          </button>
        </div>

      </form>

      {/* SECCIÓN: ACCESO DIRECTO AL MÓDULO DE INVITADOS Y FAMILIAS */}
      <div class="bg-gradient-to-r from-amber-50 via-orange-50/40 to-stone-50 border border-amber-200/80 rounded-2xl p-6 sm:p-7 shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-5">
        <div class="space-y-1.5">
          <div class="flex items-center gap-2.5 flex-wrap">
            <span class="w-8 h-8 rounded-xl bg-amber-500/20 text-amber-900 border border-amber-300/60 flex items-center justify-center text-base">
              👥
            </span>
            <h3 class="text-base font-bold text-stone-900">
              Gestión de Invitados y Familias
            </h3>
            <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-amber-200/70 text-amber-950 border border-amber-300">
              {totalInvitadosCount} {totalInvitadosCount === 1 ? 'registro' : 'registros'} ({totalPasesCount} pases)
            </span>
          </div>
          <p class="text-xs text-stone-600 max-w-xl leading-relaxed">
            Administra los invitados y grupos familiares para este evento, códigos de pase, cantidad de personas asignadas y estado de confirmación RSVP.
          </p>
        </div>

        <a
          href={`/admin/invitados?evento_id=${evento.id}`}
          class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-stone-900 hover:bg-stone-800 text-amber-200 text-xs font-bold shadow-md hover:shadow-lg transition-all shrink-0 cursor-pointer"
        >
          <span>Administrar Invitados</span>
          <span class="text-amber-400">→</span>
        </a>
      </div>

      {/* SECCIÓN: ACCESO DIRECTO AL MÓDULO DE MESAS Y ASIGNACIONES */}
      <div class="bg-gradient-to-r from-stone-50 via-amber-50/30 to-stone-50 border border-stone-200/80 rounded-2xl p-6 sm:p-7 shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-5">
        <div class="space-y-1.5">
          <div class="flex items-center gap-2.5 flex-wrap">
            <span class="w-8 h-8 rounded-xl bg-stone-800 text-amber-300 border border-stone-700 flex items-center justify-center text-base">
              🪑
            </span>
            <h3 class="text-base font-bold text-stone-900">
              Distribución de Mesas y Asignación
            </h3>
            <span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-stone-100 text-stone-800 border border-stone-200">
              Módulo de Salón
            </span>
          </div>
          <p class="text-xs text-stone-600 max-w-xl leading-relaxed">
            Organiza las mesas del evento, define la capacidad física de cada una y asigna a tus invitados según sus pases confirmados para evitar sobrecupo.
          </p>
        </div>

        <a
          href={`/admin/mesas?evento_id=${evento.id}`}
          class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-stone-900 hover:bg-stone-800 text-amber-200 text-xs font-bold shadow-md hover:shadow-lg transition-all shrink-0 cursor-pointer"
        >
          <span>Gestionar Mesas</span>
          <span class="text-amber-400">→</span>
        </a>
      </div>

      {/* SECCIÓN: CONTENIDO DE LA INVITACIÓN (TABLAS RELACIONADAS) */}
      <div class="pt-8 border-t-2 border-stone-200/90 space-y-8">
        <div>
          <div class="flex items-center gap-2">
            <span class="px-2.5 py-0.5 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-100 text-amber-900 border border-amber-200">
              Módulos Dinámicos
            </span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-serif-luxury font-bold text-stone-900 mt-2">
            Contenido de la invitación
          </h2>
          <p class="text-xs sm:text-sm text-stone-500 mt-1">
            Personaliza los lugares, el itinerario, la cronología, la galería de fotos y las mesas de regalos que verán tus invitados.
          </p>
        </div>

        {/* 1. UBICACIONES */}
        <ManagerUbicaciones eventoId={evento.id} items={ubicaciones} />

        {/* 2. PROGRAMA */}
        <ManagerPrograma eventoId={evento.id} items={programa} />

        {/* 3. HISTORIAS */}
        <ManagerHistorias eventoId={evento.id} items={historias} />

        {/* 4. GALERÍA */}
        <ManagerGaleria eventoId={evento.id} items={galeria} />

        {/* 5. MESA DE REGALOS */}
        <ManagerMesaRegalos eventoId={evento.id} items={mesaRegalos} />
      </div>

    </div>

    {/* CLIENT-SIDE ENHANCEMENT: ENVÍO ASÍNCRONO SIN PÉRDIDA DE DATOS Y PREVIEW DINÁMICO */}
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const form = document.getElementById('event-form');
        const submitBtn = document.getElementById('submit-btn');
        const btnText = document.getElementById('btn-text');
        const alertContainer = document.getElementById('alert-container');
        const slugInput = document.getElementById('slug');
        const slugPreviewText = document.getElementById('slug-preview-text');
        const previewLinkTop = document.getElementById('preview-link-top');
        const portadaInput = document.getElementById('portada_url');
        const portadaImg = document.getElementById('portada-preview-img');
        const portadaEmpty = document.getElementById('portada-preview-empty');

        // Actualizar preview del slug en vivo
        if (slugInput && slugPreviewText && previewLinkTop) {
          slugInput.addEventListener('input', () => {
            const cleanSlug = slugInput.value.trim().toLowerCase();
            slugPreviewText.textContent = `/demo/${cleanSlug || 'slug'}`;
            if (cleanSlug) {
              previewLinkTop.setAttribute('href', `/demo/${cleanSlug}`);
            }
          });
        }

        // Actualizar previsualización de imagen de portada en vivo
        if (portadaInput && portadaImg && portadaEmpty) {
          portadaInput.addEventListener('input', () => {
            const url = portadaInput.value.trim();
            if (url) {
              portadaImg.src = url;
              portadaImg.classList.remove('hidden');
              portadaEmpty.classList.add('hidden');
            } else {
              portadaImg.src = '';
              portadaImg.classList.add('hidden');
              portadaEmpty.classList.remove('hidden');
            }
          });
        }

        // Manejo de envío asíncrono vía fetch para evitar recargas completas y retener datos
        if (form && submitBtn && btnText && alertContainer) {
          form.addEventListener('submit', async (e) => {
            e.preventDefault();

            // Bloquear botón durante guardado
            submitBtn.disabled = true;
            const originalText = btnText.textContent;
            btnText.textContent = 'Guardando cambios...';

            const formData = new FormData(form);

            try {
              const res = await fetch(form.action, {
                method: 'POST',
                body: formData,
                headers: {
                  'Accept': 'application/json'
                }
              });

              const result = await res.json();

              if (res.ok && result.success) {
                alertContainer.innerHTML = `
                  <div class="bg-emerald-50 border border-emerald-200 text-emerald-900 px-5 py-4 rounded-2xl flex items-center justify-between shadow-xs mb-6 animate-fade-in">
                    <div class="flex items-center gap-3">
                      <span class="w-7 h-7 rounded-full bg-emerald-500 text-white flex items-center justify-center font-bold text-sm shrink-0">✓</span>
                      <div>
                        <p class="text-xs sm:text-sm font-semibold">${result.message || 'Evento actualizado correctamente.'}</p>
                        <p class="text-[11px] text-emerald-700">Los cambios ya están reflejados en la base de datos.</p>
                      </div>
                    </div>
                  </div>
                `;
                // Desplazar suavemente hacia arriba para ver confirmación
                window.scrollTo({ top: 0, behavior: 'smooth' });
                btnText.textContent = '✓ Guardado';
                setTimeout(() => {
                  btnText.textContent = originalText;
                  submitBtn.disabled = false;
                }, 2000);
              } else {
                alertContainer.innerHTML = `
                  <div class="bg-rose-50 border border-rose-200 text-rose-900 px-5 py-4 rounded-2xl flex items-center justify-between shadow-xs mb-6 animate-fade-in">
                    <div class="flex items-center gap-3">
                      <span class="w-7 h-7 rounded-full bg-rose-500 text-white flex items-center justify-center font-bold text-sm shrink-0">✕</span>
                      <div>
                        <p class="text-xs sm:text-sm font-semibold">No pudimos guardar los cambios.</p>
                        <p class="text-[11px] text-rose-700">${result.error || 'Verifica los campos ingresados e intenta nuevamente.'}</p>
                      </div>
                    </div>
                  </div>
                `;
                window.scrollTo({ top: 0, behavior: 'smooth' });
                btnText.textContent = originalText;
                submitBtn.disabled = false;
              }
            } catch (networkError) {
              console.error('Error de red al guardar:', networkError);
              alertContainer.innerHTML = `
                <div class="bg-rose-50 border border-rose-200 text-rose-900 px-5 py-4 rounded-2xl flex items-center justify-between shadow-xs mb-6 animate-fade-in">
                  <div class="flex items-center gap-3">
                    <span class="w-7 h-7 rounded-full bg-rose-500 text-white flex items-center justify-center font-bold text-sm shrink-0">✕</span>
                    <div>
                      <p class="text-xs sm:text-sm font-semibold">No pudimos guardar los cambios.</p>
                      <p class="text-[11px] text-rose-700">Error de conexión con el servidor. Intenta de nuevo.</p>
                    </div>
                  </div>
                </div>
              `;
              window.scrollTo({ top: 0, behavior: 'smooth' });
              btnText.textContent = originalText;
              submitBtn.disabled = false;
            }
          });
        }

        // Manejo de publicación rápida desde el Centro de Producción
        const fastToggleBtn = document.getElementById('btn-fast-toggle-publish');
        if (fastToggleBtn) {
          fastToggleBtn.addEventListener('click', async () => {
            const id = fastToggleBtn.dataset.id;
            const isPub = fastToggleBtn.dataset.publicado === 'true';
            const actionText = isPub ? 'pausar la publicación de' : 'publicar en línea';

            if (!confirm(`¿Estás seguro de que deseas ${actionText} este evento?`)) {
              return;
            }

            fastToggleBtn.disabled = true;
            fastToggleBtn.textContent = 'Actualizando...';

            try {
              const res = await fetch('/api/admin/eventos', {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id, estado: !isPub }),
              });

              const json = await res.json();
              if (json.success) {
                window.location.reload();
              } else {
                if (json.bloqueantes && json.bloqueantes.length > 0) {
                  const listStr = json.bloqueantes.map((b: string) => `• ${b}`).join('\n');
                  alert(`No es posible publicar el evento. Faltan requisitos críticos obligatorios:\n\n${listStr}`);
                } else {
                  alert(json.error || 'Error al cambiar estado.');
                }
                fastToggleBtn.disabled = false;
                fastToggleBtn.textContent = isPub ? 'Pausar publicación' : 'Publicar ahora ✓';
              }
            } catch {
              alert('Error de conexión con el servidor.');
              fastToggleBtn.disabled = false;
              fastToggleBtn.textContent = isPub ? 'Pausar publicación' : 'Publicar ahora ✓';
            }
          });
        }
      });
    </script>
  </AdminLayout>
)}
