---
import type { ProgramaItem } from '@/types';

interface Props {
  programa?: ProgramaItem[];
  displayDate?: string;
}

const { programa = [], displayDate } = Astro.props;
const sortedPrograma = [...programa].sort((a, b) => a.orden - b.orden);

const formatTime = (timeStr: string) => {
  if (!timeStr) return '';
  if (timeStr.toUpperCase().includes('HRS')) return timeStr;
  const parts = timeStr.split(':');
  if (parts.length >= 2) {
    return `${parts[0]}:${parts[1]} HRS`;
  }
  return `${timeStr} HRS`;
};
---

{sortedPrograma.length > 0 && (
  <section class="py-24 px-4 max-w-4xl mx-auto">
    <div class="text-center space-y-3 mb-16">
      <span class="text-xs uppercase tracking-[0.3em] text-rose-700 font-semibold">Itinerario</span>
      <h2 class="text-3xl sm:text-5xl font-serif-luxury text-stone-900">
        Programa del Gran Día
      </h2>
      {displayDate && <p class="text-xs text-stone-500 font-sans-clean">{displayDate}</p>}
    </div>

    <div class="relative border-l-2 border-amber-200 ml-4 sm:ml-32 space-y-12 pl-6 sm:pl-10">
      {sortedPrograma.map((item) => (
        <div class="relative group">
          <div class="absolute -left-[31px] sm:-left-[47px] top-1.5 w-5 h-5 rounded-full bg-rose-600 border-4 border-[#faf8f5] shadow-md"></div>
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
            <span class="text-xs font-bold uppercase tracking-wider text-rose-700 font-mono">
              {formatTime(item.hora)}
            </span>
            <h3 class="text-xl font-serif-luxury font-bold text-stone-900">{item.titulo}</h3>
          </div>
          <p class="text-xs text-stone-600 mt-1 font-sans-clean">{item.descripcion}</p>
        </div>
      ))}
    </div>
  </section>
)}
