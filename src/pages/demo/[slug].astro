---
import Layout from '@/layouts/Layout.astro';
import { WeddingMusicPlayer } from '@/components/invitation/WeddingMusicPlayer';
import Hero from '@/components/invitation/Hero.astro';
import Historia from '@/components/invitation/Historia.astro';
import Programa from '@/components/invitation/Programa.astro';
import Ubicacion from '@/components/invitation/Ubicacion.astro';
import DressCode from '@/components/invitation/DressCode.astro';
import Galeria from '@/components/invitation/Galeria.astro';
import MesaRegalos from '@/components/invitation/MesaRegalos.astro';
import Rsvp from '@/components/invitation/Rsvp.astro';
import Footer from '@/components/invitation/Footer.astro';
import { supabase } from '@/lib/supabase';
import type {
  Evento,
  UbicacionItem,
  ProgramaItem,
  GaleriaItem,
  HistoriaItem,
  MesaRegalosItem,
  InvitadoItem
} from '@/types';

const { slug } = Astro.params;

// 1. Obtener evento principal
const { data: eventoData, error: eventoError } = await supabase
  .from('eventos')
  .select('*')
  .eq('slug', slug)
  .eq('estado', true)
  .single();

if (eventoError || !eventoData) {
  return new Response(null, {
    status: 404,
    statusText: 'Not Found',
  });
}

const evento: Evento = eventoData;

// 1.1 Validar código de invitación si se especificó en la URL
const codigoParam = Astro.url.searchParams.get('codigo')?.trim();
let invitado: InvitadoItem | null = null;
let codigoInvalido = false;

if (codigoParam) {
  try {
    const { data: invData, error: invError } = await supabase
      .from('invitados')
      .select('*')
      .eq('codigo', codigoParam)
      .maybeSingle();

    // Validar existencia y aislamiento por evento_id
    if (invError || !invData || invData.evento_id !== evento.id) {
      codigoInvalido = true;
      Astro.response.status = 404;
    } else {
      invitado = invData as InvitadoItem;
    }
  } catch (err) {
    console.error('[Demo Slug] Error buscando invitado por código:', err);
    codigoInvalido = true;
    Astro.response.status = 404;
  }
}

// 2. Obtener datos relacionados concurrentemente
const [
  { data: ubicacionesData, error: ubicacionesError },
  { data: programaData, error: programaError },
  { data: galeriaData, error: galeriaError },
  { data: historiasData, error: historiasError },
  { data: mesaRegalosData, error: mesaRegalosError },
] = await Promise.all([
  supabase
    .from('ubicaciones')
    .select('*')
    .eq('evento_id', evento.id)
    .order('id'),
  supabase
    .from('programa_evento')
    .select('*')
    .eq('evento_id', evento.id)
    .order('orden'),
  supabase
    .from('galeria')
    .select('*')
    .eq('evento_id', evento.id)
    .order('orden'),
  supabase
    .from('historias')
    .select('*')
    .eq('evento_id', evento.id)
    .order('orden'),
  supabase
    .from('mesa_regalos')
    .select('*')
    .eq('evento_id', evento.id)
    .order('orden'),
]);

if (ubicacionesError) console.error('Error al cargar ubicaciones:', ubicacionesError.message);
if (programaError) console.error('Error al cargar programa_evento:', programaError.message);
if (galeriaError) console.error('Error al cargar galeria:', galeriaError.message);
if (historiasError) console.error('Error al cargar historias:', historiasError.message);
if (mesaRegalosError) console.error('Error al cargar mesa_regalos:', mesaRegalosError.message);

const ubicaciones: UbicacionItem[] = ubicacionesData ?? [];
const programa: ProgramaItem[] = programaData ?? [];
const galeria: GaleriaItem[] = galeriaData ?? [];
const historias: HistoriaItem[] = historiasData ?? [];
const mesaRegalos: MesaRegalosItem[] = mesaRegalosData ?? [];

// Helper para formatear la fecha que viene de Supabase
const formatEventDate = (dateString: string) => {
  if (!dateString) return 'Sábado, 28 Noviembre 2026';
  const date = new Date(dateString + "T12:00:00Z");
  const options: Intl.DateTimeFormatOptions = { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' };
  const formatted = new Intl.DateTimeFormat('es-MX', options).format(date);
  return formatted.charAt(0).toUpperCase() + formatted.slice(1);
};
const displayDate = evento.fecha_evento ? formatEventDate(evento.fecha_evento) : 'Sábado, 28 Noviembre 2026';

// Event target date & time for countdown
const eventTime = evento.hora_evento?.trim() || '17:00:00';
const eventDateStr = evento.fecha_evento || '2026-12-28';
const targetDate = `${eventDateStr}T${eventTime}`;
---

{codigoInvalido ? (
  <Layout title={`Invitación no encontrada | Celebra-Ya`}>
    <main class="min-h-screen bg-[#faf8f5] flex items-center justify-center p-4">
      <div class="max-w-md w-full bg-white rounded-3xl border border-stone-200 p-8 sm:p-10 text-center shadow-lg space-y-6">
        <div class="w-16 h-16 rounded-2xl bg-amber-50 border border-amber-200 text-amber-800 flex items-center justify-center text-3xl mx-auto shadow-xs">
          💌
        </div>
        <div class="space-y-2">
          <h1 class="text-2xl sm:text-3xl font-serif-luxury font-bold text-stone-900">
            Invitación no encontrada
          </h1>
          <p class="text-sm text-stone-600 font-serif italic">
            El enlace de invitación no es válido o ya no está disponible.
          </p>
        </div>
        <p class="text-xs text-stone-500 leading-relaxed">
          Verifica que el código de acceso proporcionado sea correcto o comunícate con los anfitriones del evento para obtener un enlace actualizado.
        </p>
        <div class="pt-2">
          <a
            href={`/demo/${evento.slug}`}
            class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-stone-900 hover:bg-stone-800 text-amber-200 text-xs font-bold transition-all shadow-md"
          >
            Ver invitación general
          </a>
        </div>
      </div>
    </main>
  </Layout>
) : (
  <Layout title={`${evento.tipo_evento || 'Boda'} ${evento.nombre} | ${displayDate}`}>
    {/* Google Fonts for Luxury Wedding Typography */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Great+Vibes&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <style>
      .font-serif-luxury {
        font-family: 'Cormorant Garamond', Georgia, serif;
      }
      .font-script {
        font-family: 'Great Vibes', cursive;
      }
      .font-sans-clean {
        font-family: 'Montserrat', sans-serif;
      }
    </style>

    {/* Background Music Player */}
    <WeddingMusicPlayer client:load musicaUrl={evento.musica_url} />

    <main class="bg-[#faf8f5] text-stone-800 font-sans-clean selection:bg-rose-100 selection:text-rose-900 min-h-screen">
      
      {/* HERO SECTION */}
      <Hero evento={evento} displayDate={displayDate} weddingDate={targetDate} />

      {/* NUESTRA HISTORIA */}
      <Historia historias={historias} />

      {/* ITINERARIO DEL EVENTO */}
      <Programa programa={programa} displayDate={displayDate} />

      {/* UBICACIONES GPS */}
      <Ubicacion ubicaciones={ubicaciones} />

      {/* DRESS CODE */}
      <DressCode evento={evento} />

      {/* GALERÍA DE FOTOS */}
      <Galeria galeria={galeria} />

      {/* MESA DE REGALOS */}
      <MesaRegalos regalos={mesaRegalos} />

      {/* CONFIRMACIÓN RSVP */}
      <Rsvp evento={evento} invitado={invitado} />

      {/* WEDDING FOOTER */}
      <Footer evento={evento} displayDate={displayDate} />

    </main>
  </Layout>
)}
