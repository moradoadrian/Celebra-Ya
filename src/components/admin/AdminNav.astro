---
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navItems = [
  {
    label: 'Inicio',
    href: '/admin',
    icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6',
    isActive: currentPath === '/admin' || currentPath === '/admin/'
  },
  {
    label: 'Eventos',
    href: '/admin/eventos',
    icon: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z',
    isActive: currentPath.startsWith('/admin/eventos')
  },
  {
    label: 'Invitados',
    href: '/admin/invitados',
    icon: 'M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z',
    isActive: currentPath.startsWith('/admin/invitados')
  },
  {
    label: 'Mesas',
    href: '/admin/mesas',
    icon: 'M4 6a2 2 0 012-2h12a2 2 0 012 2v2H4V6zm0 4h16v3a1 1 0 01-1 1h-2v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6h-2v6a1 1 0 01-1 1H8a1 1 0 01-1-1v-6H5a1 1 0 01-1-1v-3z',
    isActive: currentPath.startsWith('/admin/mesas')
  },
  {
    label: 'Check-in',
    href: '/admin/checkin',
    icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4',
    isActive: currentPath.startsWith('/admin/checkin')
  },
  {
    label: 'Clientes',
    href: '/admin/clientes',
    icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z',
    isActive: currentPath.startsWith('/admin/clientes')
  }
];
---

<nav class="space-y-1 px-3">
  {navItems.map((item) => (
    <a
      href={item.href}
      aria-current={item.isActive ? 'page' : undefined}
      class={`flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold transition-colors ${
        item.isActive
          ? 'bg-violet-50 text-violet-700'
          : 'text-stone-600 hover:text-stone-900 hover:bg-stone-100'
      }`}
    >
      <svg
        width="20"
        height="20"
        class={`w-5 h-5 shrink-0 ${item.isActive ? 'text-violet-600' : 'text-stone-400'}`}
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon} />
      </svg>
      <span>{item.label}</span>
    </a>
  ))}

  <div class="pt-3 mt-3 border-t border-stone-100 space-y-1">
    <a
      href="/demo/boda-sofia-alejandro"
      target="_blank"
      class="md:hidden flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold text-stone-600 hover:text-stone-900 hover:bg-stone-100 transition-colors"
    >
      <svg width="20" height="20" class="w-5 h-5 shrink-0 text-stone-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
      <span>Ver demo pública</span>
    </a>
    <a
      href="/admin/logout"
      class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-semibold text-rose-600 hover:bg-rose-50 transition-colors"
    >
      <svg width="20" height="20" class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
      </svg>
      <span>Cerrar sesión</span>
    </a>
  </div>
</nav>
