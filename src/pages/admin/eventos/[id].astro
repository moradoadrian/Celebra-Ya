---
import AdminLayout from '@/components/admin/AdminLayout.astro';
import ManagerUbicaciones from '@/components/admin/ManagerUbicaciones.astro';
import ManagerPrograma from '@/components/admin/ManagerPrograma.astro';
import ManagerHistorias from '@/components/admin/ManagerHistorias.astro';
import ManagerGaleria from '@/components/admin/ManagerGaleria.astro';
import ManagerMesaRegalos from '@/components/admin/ManagerMesaRegalos.astro';
import { createSupabaseServerClient } from '@/lib/supabase-server';
import { evaluarProgresoEvento, calcularMetricasOperativasEvento } from '@/lib/event-production';
import type {
  Evento,
  UbicacionItem,
  ProgramaItem,
  HistoriaItem,
  GaleriaItem,
  MesaRegalosItem,
  ClienteItem,
  EventoMetricasOperativas,
} from '@/types';

// 1. Verificación defensiva de autenticación (el middleware ya protege /admin/*)
const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/admin/login');
}

const userEmail = user.email || 'Administrador';

// 2. Obtención y validación del parámetro ID
const { id } = Astro.params;
const eventId = Number(id);

let evento: Evento | null = null;
let notFound = false;
let loadError: string | null = null;

let ubicaciones: UbicacionItem[] = [];
let programa: ProgramaItem[] = [];
let historias: HistoriaItem[] = [];
let galeria: GaleriaItem[] = [];
let mesaRegalos: MesaRegalosItem[] = [];

let totalInvitadosCount = 0;
let totalPasesCount = 0;
let totalMesasCount = 0;
let clientes: ClienteItem[] = [];
let metricasOperativas: EventoMetricasOperativas | null = null;

if (!id || isNaN(eventId) || eventId <= 0) {
  notFound = true;
  Astro.response.status = 404;
} else {
  // 3. Consulta SSR a public.eventos y tablas relacionadas
  const supabase = createSupabaseServerClient({
    headers: Astro.request.headers,
    cookies: Astro.cookies,
  });

  try {
    const { data, error } = await supabase
      .from('eventos')
      .select('*')
      .eq('id', eventId)
      .single();

    if (error || !data) {
      notFound = true;
      Astro.response.status = 404;
    } else {
      evento = data as Evento;

      // Cargar tablas relacionadas del evento, clientes, conteos, check-ins y mesas en paralelo
      const [
        { data: resUbicaciones },
        { data: resPrograma },
        { data: resHistorias },
        { data: resGaleria },
        { data: resMesaRegalos },
        { data: resInvitados },
        { data: resMesas },
        { data: resCheckins },
        { data: resClientes },
      ] = await Promise.all([
        supabase.from('ubicaciones').select('*').eq('evento_id', eventId).order('id'),
        supabase.from('programa_evento').select('*').eq('evento_id', eventId).order('orden'),
        supabase.from('historias').select('*').eq('evento_id', eventId).order('orden'),
        supabase.from('galeria').select('*').eq('evento_id', eventId).order('orden'),
        supabase.from('mesa_regalos').select('*').eq('evento_id', eventId).order('orden'),
        supabase.from('invitados').select('id, numero_pases, confirmado, pases_confirmados').eq('evento_id', eventId),
        supabase.from('mesas').select('id, numero, capacidad').eq('evento_id', eventId),
        supabase.from('checkins').select('id, cantidad').eq('evento_id', eventId),
        supabase.from('clientes').select('id, nombre, email, whatsapp, telefono, activo').order('nombre'),
      ]);

      ubicaciones = (resUbicaciones as UbicacionItem[]) ?? [];
      programa = (resPrograma as ProgramaItem[]) ?? [];
      historias = (resHistorias as HistoriaItem[]) ?? [];
      galeria = (resGaleria as GaleriaItem[]) ?? [];
      mesaRegalos = (resMesaRegalos as MesaRegalosItem[]) ?? [];
      totalMesasCount = (resMesas || []).length;
      clientes = (resClientes as any[]) ?? [];

      if (resInvitados && Array.isArray(resInvitados)) {
        totalInvitadosCount = resInvitados.length;
        totalPasesCount = resInvitados.reduce((sum, item: any) => sum + (Number(item.numero_pases) || 1), 0);
      }

      metricasOperativas = evento
        ? calcularMetricasOperativasEvento(evento, {
            invitados: (resInvitados as any[]) || [],
            mesas: (resMesas as any[]) || [],
            checkins: (resCheckins as any[]) || [],
          })
        : null;
    }
  } catch (err) {
    console.error('Error cargando evento para edición:', err);
    loadError = 'Error de conexión con el servidor.';
    notFound = true;
    Astro.response.status = 500;
  }
}

// 4. Parámetros de feedback recibidos por redirección (fallback sin JS)
const isSaved = Astro.url.searchParams.get('saved') === 'true';
const errorParam = Astro.url.searchParams.get('error');

const isPublicado =
  evento?.estado === true ||
  evento?.estado === 'true' ||
  evento?.estado === 'publicado';

// 5. Evaluación de producción para el Centro de Preparación
const produccion = evento
  ? evaluarProgresoEvento(evento, {
      ubicacionesCount: ubicaciones.length,
      invitadosCount: totalInvitadosCount,
      mesasCount: totalMesasCount,
    })
  : null;

const clienteAsignado = evento?.cliente_id
  ? clientes.find((c) => c.id === evento.cliente_id) || null
  : null;
---

{notFound || !evento ? (
  <AdminLayout title="Evento no encontrado | Celebra-Ya Admin" userEmail={userEmail}>
    <div class="max-w-xl mx-auto py-16 px-4 text-center space-y-6">
      <div class="w-16 h-16 rounded-2xl bg-stone-200/70 border border-stone-300 text-stone-500 flex items-center justify-center text-2xl mx-auto shadow-xs">
        🔍
      </div>
      <div>
        <h1 class="text-2xl sm:text-3xl font-serif-luxury font-bold text-stone-900">
          Evento no encontrado
        </h1>
        <p class="text-xs sm:text-sm text-stone-500 mt-2 max-w-md mx-auto leading-relaxed">
          {loadError || `El evento #${id || ''} no existe o no se encuentra disponible en la base de datos.`}
        </p>
      </div>
      <div class="pt-2">
        <a
          href="/admin"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-stone-900 hover:bg-stone-800 text-amber-200 font-semibold text-xs tracking-wide transition-all shadow-xs"
        >
          <span>←</span>
          <span>Volver a eventos</span>
        </a>
      </div>
    </div>
  </AdminLayout>
) : (
  <AdminLayout title={`Editar: ${evento.nombre} | Celebra-Ya Admin`} userEmail={userEmail}>
    <div class="max-w-5xl mx-auto space-y-8 pb-16">
      
      {/* HEADER DE PÁGINA */}
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 border-b border-stone-200/80 pb-6">
        <div>
          <div class="flex items-center gap-2 mb-1.5">
            <a
              href="/admin"
              class="inline-flex items-center gap-1 text-xs font-semibold text-stone-500 hover:text-stone-900 transition-colors"
            >
              <span>←</span>
              <span>Volver a eventos</span>
            </a>
            <span class="text-stone-300">/</span>
            <span class="text-xs font-mono text-stone-400">ID #{evento.id}</span>
          </div>

          <div class="flex flex-wrap items-center gap-3">
            <h1 class="text-2xl sm:text-3xl font-serif-luxury font-bold text-stone-900">
              Editar evento
            </h1>
            <span class="px-3 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-900 border border-amber-200/80 shadow-xs">
              {evento.nombre}
            </span>
          </div>

          <p class="text-xs sm:text-sm text-stone-500 mt-1">
            Actualiza la información de tu invitación digital.
          </p>
        </div>

        {/* ACCIONES SUPERIORES */}
        <div class="flex items-center gap-2.5 shrink-0 flex-wrap">
          <a
            href={`/admin/checkin?evento_id=${evento.id}`}
            class="inline-flex items-center gap-1.5 px-3.5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold shadow-xs transition-colors"
          >
            <span>🎟️</span>
            <span>Check-in</span>
          </a>
          <a
            href={`/admin/mesas?evento_id=${evento.id}`}
            class="inline-flex items-center gap-1.5 px-3.5 py-2.5 rounded-xl bg-white hover:bg-stone-50 text-stone-700 text-xs font-semibold border border-stone-300/80 shadow-xs transition-colors"
          >
            <span>🪑</span>
            <span>Mesas</span>
          </a>
          <a
            href={`/admin/invitados?evento_id=${evento.id}`}
            class="inline-flex items-center gap-1.5 px-3.5 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-600 text-stone-950 text-xs font-bold shadow-xs transition-colors"
          >
            <span>👥</span>
            <span>Invitados ({totalInvitadosCount})</span>
          </a>
          <a
            id="preview-admin-top"
            href={`/admin/eventos/${evento.id}/preview`}
            class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-stone-900 hover:bg-stone-800 text-amber-300 text-xs font-semibold shadow-xs transition-colors"
          >
            <span>👁️</span>
            <span>Vista Previa</span>
          </a>
          {isPublicado && (
            <a
              id="preview-link-top"
              href={`/demo/${evento.slug}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-white hover:bg-stone-50 text-stone-700 text-xs font-semibold border border-stone-300/80 shadow-xs transition-colors"
            >
              <span>Ver pública</span>
              <svg width="13" height="13" class="w-3.5 h-3.5 text-stone-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          )}
        </div>
      </div>

      {/* BANNER DE NOTIFICACIONES (FEEDBACK) */}
      <div id="alert-container">
        {isSaved && (
          <div class="bg-emerald-50 border border-emerald-200 text-emerald-900 px-5 py-4 rounded-2xl flex items-center justify-between shadow-xs mb-6 animate-fade-in">
            <div class="flex items-center gap-3">
              <span class="w-7 h-7 rounded-full bg-emerald-500 text-white flex items-center justify-center font-bold text-sm shrink-0">✓</span>
              <div>
                <p class="text-xs sm:text-sm font-semibold">Evento actualizado correctamente.</p>
                <p class="text-[11px] text-emerald-700">Los cambios ya están reflejados en la base de datos.</p>
              </div>
            </div>
          </div>
        )}

        {errorParam && (
          <div class="bg-rose-50 border border-rose-200 text-rose-900 px-5 py-4 rounded-2xl flex items-center justify-between shadow-xs mb-6 animate-fade-in">
            <div class="flex items-center gap-3">
              <span class="w-7 h-7 rounded-full bg-rose-500 text-white flex items-center justify-center font-bold text-sm shrink-0">✕</span>
              <div>
                <p class="text-xs sm:text-sm font-semibold">No pudimos guardar los cambios.</p>
                <p class="text-[11px] text-rose-700">{decodeURIComponent(errorParam)}</p>
              </div>
            </div>
          </div>
        )}
      </div>

      {/* AVISO DE CIERRE / ARCHIVO HISTÓRICO SI EL EVENTO ESTÁ FINALIZADO (PASO 10 DEL CICLO) */}
      {metricasOperativas?.esFinalizado && (
        <div class="bg-stone-900 border border-stone-800 text-stone-100 p-5 rounded-3xl shadow-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div class="flex items-center gap-3.5">
            <span class="w-10 h-10 rounded-2xl bg-stone-800 text-amber-300 flex items-center justify-center text-xl shrink-0">
              🏛️
            </span>
            <div>
              <div class="flex items-center gap-2">
                <h3 class="text-sm font-bold text-white font-serif-luxury text-base">Evento Finalizado (Ciclo Completo)</h3>
                <span class="text-[10px] uppercase font-bold bg-amber-400/20 text-amber-300 px-2 py-0.5 rounded border border-amber-400/30">
                  Histórico Preservado
                </span>
              </div>
              <p class="text-xs text-stone-400 mt-0.5 leading-relaxed">
                Este evento ya concluyó su fecha operativa. Los registros históricos de invitados, confirmaciones RSVP, distribución de mesas y check-ins de recepción se conservan íntegros para auditoría y consulta.
              </p>
            </div>
          </div>
          <div class="shrink-0 flex items-center gap-2">
            <a
              href={`/admin/checkin?evento_id=${evento.id}`}
              class="px-3.5 py-2 rounded-xl bg-stone-800 hover:bg-stone-700 text-amber-300 text-xs font-semibold border border-stone-700 transition-colors"
            >
              Auditoría de check-ins ↗
            </a>
          </div>
        </div>
      )}

      {/* CENTRO DE CONTROL: INDICADORES OPERATIVOS EN TIEMPO REAL */}
      {metricasOperativas && (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          
          {/* 1. Invitados & RSVP */}
          <div class="bg-white border border-stone-200/80 rounded-2xl p-5 shadow-xs flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between">
                <span class="text-[11px] font-semibold uppercase tracking-wider text-stone-500">Invitados & RSVP</span>
                <span class="text-base">👥</span>
              </div>
              <div class="mt-2">
                <span class="text-2xl font-bold font-serif-luxury text-stone-900">{metricasOperativas.totalInvitados}</span>
                <span class="text-xs text-stone-500 ml-1 font-medium">({metricasOperativas.totalPases} pases)</span>
              </div>
              <div class="mt-2 space-y-0.5 text-[11px] text-stone-600">
                <p class="text-emerald-700 font-medium">✓ {metricasOperativas.invitadosConfirmados} confirmados ({metricasOperativas.pasesConfirmados} pases)</p>
                <p class="text-stone-500">⏳ {metricasOperativas.invitadosPendientes} pendientes • ✕ {metricasOperativas.invitadosRechazados} declinados</p>
              </div>
            </div>
            <div class="pt-3 mt-3 border-t border-stone-100">
              <a href={`/admin/invitados?evento_id=${evento.id}`} class="text-xs font-bold text-amber-800 hover:text-amber-900 underline flex items-center justify-between">
                <span>Gestionar invitados</span>
                <span>→</span>
              </a>
            </div>
          </div>

          {/* 2. Mesas & Capacidad */}
          <div class="bg-white border border-stone-200/80 rounded-2xl p-5 shadow-xs flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between">
                <span class="text-[11px] font-semibold uppercase tracking-wider text-stone-500">Mesas & Asientos</span>
                <span class="text-base">🪑</span>
              </div>
              <div class="mt-2">
                <span class="text-2xl font-bold font-serif-luxury text-stone-900">{metricasOperativas.totalMesas}</span>
                <span class="text-xs text-stone-500 ml-1 font-medium">mesas configuradas</span>
              </div>
              <div class="mt-2 text-[11px] text-stone-600">
                <p class="text-stone-700 font-medium">{metricasOperativas.capacidadMesas} asientos disponibles</p>
                <p class="text-stone-500 mt-0.5">{metricasOperativas.totalMesas > 0 ? 'Distribución activa' : 'Sin distribución asignada'}</p>
              </div>
            </div>
            <div class="pt-3 mt-3 border-t border-stone-100">
              <a href={`/admin/mesas?evento_id=${evento.id}`} class="text-xs font-bold text-amber-800 hover:text-amber-900 underline flex items-center justify-between">
                <span>Configurar mesas</span>
                <span>→</span>
              </a>
            </div>
          </div>

          {/* 3. Recepción & Check-in */}
          <div class="bg-white border border-stone-200/80 rounded-2xl p-5 shadow-xs flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between">
                <span class="text-[11px] font-semibold uppercase tracking-wider text-stone-500">Recepción / Check-in</span>
                <span class="text-base">🎟️</span>
              </div>
              <div class="mt-2">
                <span class="text-2xl font-bold font-serif-luxury text-indigo-900">{metricasOperativas.pasesIngresados}</span>
                <span class="text-xs text-stone-500 ml-1 font-medium">personas ingresadas</span>
              </div>
              <div class="mt-2 text-[11px] text-stone-600">
                <div class="flex items-center justify-between mb-1">
                  <span class="font-medium text-stone-700">{metricasOperativas.asistenciaPorcentaje}% de asistencia</span>
                  <span class="text-stone-400 font-mono text-[10px]">{metricasOperativas.pasesIngresados}/{metricasOperativas.pasesConfirmados || metricasOperativas.totalPases}</span>
                </div>
                <div class="w-full bg-stone-100 rounded-full h-1.5 overflow-hidden">
                  <div class="h-full bg-indigo-500 rounded-full" style={`width: ${metricasOperativas.asistenciaPorcentaje}%`}></div>
                </div>
              </div>
            </div>
            <div class="pt-3 mt-3 border-t border-stone-100">
              <a href={`/admin/checkin?evento_id=${evento.id}`} class="text-xs font-bold text-indigo-700 hover:text-indigo-900 underline flex items-center justify-between">
                <span>Abrir recepción en vivo</span>
                <span>→</span>
              </a>
            </div>
          </div>

          {/* 4. Estado de Producción & Publicación */}
          <div class="bg-white border border-stone-200/80 rounded-2xl p-5 shadow-xs flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between">
                <span class="text-[11px] font-semibold uppercase tracking-wider text-stone-500">Ciclo de Vida</span>
                <span class="text-base">🚀</span>
              </div>
              <div class="mt-2 flex items-center gap-2">
                <span class="text-xl font-bold font-serif-luxury text-stone-900">{produccion?.etapaLabel}</span>
              </div>
              <div class="mt-2 text-[11px] space-y-1">
                <div class="flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full" class:list={[isPublicado ? 'bg-emerald-500' : 'bg-amber-500']}></span>
                  <span class="font-bold" class:list={[isPublicado ? 'text-emerald-700' : 'text-amber-700']}>
                    {isPublicado ? 'PUBLICADO EN LÍNEA' : 'MODO BORRADOR'}
                  </span>
                </div>
                <p class="text-stone-500">{produccion?.progresoPorcentaje}% de preparación completada</p>
              </div>
            </div>
            <div class="pt-3 mt-3 border-t border-stone-100">
              <a href={`/admin/eventos/${evento.id}/preview`} class="text-xs font-bold text-stone-800 hover:text-amber-800 underline flex items-center justify-between">
                <span>Vista previa admin</span>
                <span>→</span>
              </a>
            </div>
          </div>

        </div>
      )}

      {/* WIDGET: CENTRO DE PRODUCCIÓN Y CHECKLIST DEL EVENTO */}
      {produccion && (
        <div class="bg-white border border-stone-200/80 rounded-3xl p-6 sm:p-7 shadow-xs space-y-5">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-stone-100 pb-4">
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span class="text-[10px] uppercase font-bold tracking-wider text-amber-800 bg-amber-50 px-2 py-0.5 rounded-md border border-amber-200/70">
                  Ciclo de Producción
                </span>
                <span class="text-stone-300">•</span>
                <span
                  class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-bold border"
                  class:list={[
                    produccion.etapa === 'PUBLICADO' && 'bg-emerald-50 text-emerald-700 border-emerald-200',
                    produccion.etapa === 'EN_REVISION' && 'bg-indigo-50 text-indigo-700 border-indigo-200',
                    produccion.etapa === 'EN_PREPARACION' && 'bg-amber-50 text-amber-800 border-amber-200',
                    produccion.etapa === 'INFORMACION_PENDIENTE' && 'bg-rose-50 text-rose-700 border-rose-200',
                    produccion.etapa === 'FINALIZADO' && 'bg-stone-100 text-stone-600 border-stone-200',
                  ]}
                >
                  <span
                    class="w-1.5 h-1.5 rounded-full"
                    class:list={[
                      produccion.etapa === 'PUBLICADO' && 'bg-emerald-500',
                      produccion.etapa === 'EN_REVISION' && 'bg-indigo-500',
                      produccion.etapa === 'EN_PREPARACION' && 'bg-amber-500',
                      produccion.etapa === 'INFORMACION_PENDIENTE' && 'bg-rose-500',
                      produccion.etapa === 'FINALIZADO' && 'bg-stone-400',
                    ]}
                  ></span>
                  <span>{produccion.etapaLabel}</span>
                </span>
              </div>
              <h2 class="text-base font-serif-luxury font-bold text-stone-900">
                Estado de Preparación de la Invitación
              </h2>
              <p class="text-xs text-stone-500 mt-0.5">
                Cliente responsable: {clienteAsignado ? <a href="/admin/clientes" class="font-semibold text-stone-800 hover:text-amber-700 underline">{clienteAsignado.nombre}</a> : <span class="text-rose-600 font-medium">⚠️ Sin cliente asignado</span>}
              </p>
            </div>

            <div class="flex items-center gap-3">
              <div class="text-right sm:text-right">
                <span class="text-xs font-bold text-stone-800 block">
                  {produccion.itemsCompletados} de {produccion.totalItems} completados
                </span>
                <span class="text-[11px] text-amber-800 font-semibold">
                  {produccion.progresoPorcentaje}% listo para operar
                </span>
              </div>

              {/* Botón rápido publicar / despublicar */}
              <button
                type="button"
                id="btn-fast-toggle-publish"
                class="px-3.5 py-2 rounded-xl text-xs font-bold shadow-xs transition-all border"
                class:list={[
                  isPublicado
                    ? 'bg-stone-100 hover:bg-stone-200 text-stone-700 border-stone-300'
                    : 'bg-emerald-600 hover:bg-emerald-700 text-white border-emerald-600',
                ]}
                data-id={evento.id}
                data-publicado={isPublicado ? 'true' : 'false'}
              >
                {isPublicado ? 'Pausar publicación' : 'Publicar ahora ✓'}
              </button>
            </div>
          </div>

          {/* BARRA DE PROGRESO */}
          <div class="w-full bg-stone-100 rounded-full h-2.5 overflow-hidden">
            <div
              class="h-full rounded-full transition-all duration-500"
              class:list={[
                produccion.progresoPorcentaje >= 100
                  ? 'bg-emerald-500'
                  : produccion.progresoPorcentaje >= 60
                  ? 'bg-amber-500'
                  : 'bg-rose-500',
              ]}
              style={`width: ${produccion.progresoPorcentaje}%`}
            ></div>
          </div>

          {/* GRID DE CHECKLIST DE PRODUCCIÓN */}
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 pt-1">
