---
import Layout from '@/layouts/Layout.astro';
import { WeddingMusicPlayer } from '@/components/invitation/WeddingMusicPlayer';
import Hero from '@/components/invitation/Hero.astro';
import Historia from '@/components/invitation/Historia.astro';
import Programa from '@/components/invitation/Programa.astro';
import Ubicacion from '@/components/invitation/Ubicacion.astro';
import DressCode from '@/components/invitation/DressCode.astro';
import Galeria from '@/components/invitation/Galeria.astro';
import MesaRegalos from '@/components/invitation/MesaRegalos.astro';
import Rsvp from '@/components/invitation/Rsvp.astro';
import Footer from '@/components/invitation/Footer.astro';
import { supabase } from '@/lib/supabase';
import type {
  Evento,
  UbicacionItem,
  ProgramaItem,
  GaleriaItem,
  HistoriaItem,
  MesaRegalosItem
} from '@/types';

const { slug } = Astro.params;

// 1. Obtener evento principal
const { data: eventoData, error: eventoError } = await supabase
  .from('eventos')
  .select('*')
  .eq('slug', slug)
  .eq('estado', true)
  .single();

if (eventoError || !eventoData) {
  return new Response(null, {
    status: 404,
    statusText: 'Not Found',
  });
}

const evento: Evento = eventoData;

// 2. Obtener datos relacionados concurrentemente
const [
  { data: ubicacionesData, error: ubicacionesError },
  { data: programaData, error: programaError },
  { data: galeriaData, error: galeriaError },
  { data: historiasData, error: historiasError },
  { data: mesaRegalosData, error: mesaRegalosError },
] = await Promise.all([
  supabase
    .from('ubicaciones')
    .select('*')
    .eq('evento_id', evento.id)
    .order('id'),
  supabase
    .from('programa_evento')
    .select('*')
    .eq('evento_id', evento.id)
    .order('orden'),
  supabase
    .from('galeria')
    .select('*')
    .eq('evento_id', evento.id)
    .order('orden'),
  supabase
    .from('historias')
    .select('*')
    .eq('evento_id', evento.id)
    .order('orden'),
  supabase
    .from('mesa_regalos')
    .select('*')
    .eq('evento_id', evento.id)
    .order('orden'),
]);

if (ubicacionesError) console.error('Error al cargar ubicaciones:', ubicacionesError.message);
if (programaError) console.error('Error al cargar programa_evento:', programaError.message);
if (galeriaError) console.error('Error al cargar galeria:', galeriaError.message);
if (historiasError) console.error('Error al cargar historias:', historiasError.message);
if (mesaRegalosError) console.error('Error al cargar mesa_regalos:', mesaRegalosError.message);

const ubicaciones: UbicacionItem[] = ubicacionesData ?? [];
const programa: ProgramaItem[] = programaData ?? [];
const galeria: GaleriaItem[] = galeriaData ?? [];
const historias: HistoriaItem[] = historiasData ?? [];
const mesaRegalos: MesaRegalosItem[] = mesaRegalosData ?? [];

// Helper para formatear la fecha que viene de Supabase
const formatEventDate = (dateString: string) => {
  if (!dateString) return 'Sábado, 28 Noviembre 2026';
  const date = new Date(dateString + "T12:00:00Z");
  const options: Intl.DateTimeFormatOptions = { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' };
  const formatted = new Intl.DateTimeFormat('es-MX', options).format(date);
  return formatted.charAt(0).toUpperCase() + formatted.slice(1);
};
const displayDate = evento.fecha_evento ? formatEventDate(evento.fecha_evento) : 'Sábado, 28 Noviembre 2026';

// Wedding target date
const weddingDate = '2026-11-28T17:00:00';
---

<Layout title={`Boda ${evento.nombre} | ${displayDate}`}>
  {/* Google Fonts for Luxury Wedding Typography */}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Great+Vibes&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  <style>
    .font-serif-luxury {
      font-family: 'Cormorant Garamond', Georgia, serif;
    }
    .font-script {
      font-family: 'Great Vibes', cursive;
    }
    .font-sans-clean {
      font-family: 'Montserrat', sans-serif;
    }
  </style>

  {/* Background Music Player */}
  <WeddingMusicPlayer client:load />

  <main class="bg-[#faf8f5] text-stone-800 font-sans-clean selection:bg-rose-100 selection:text-rose-900 min-h-screen">
    
    {/* HERO SECTION */}
    <Hero evento={evento} displayDate={displayDate} weddingDate={weddingDate} />

    {/* NUESTRA HISTORIA */}
    <Historia historias={historias} />

    {/* ITINERARIO DEL EVENTO */}
    <Programa programa={programa} displayDate={displayDate} />

    {/* UBICACIONES GPS */}
    <Ubicacion ubicaciones={ubicaciones} />

    {/* DRESS CODE */}
    <DressCode />

    {/* GALERÍA DE FOTOS */}
    <Galeria galeria={galeria} />

    {/* MESA DE REGALOS */}
    <MesaRegalos regalos={mesaRegalos} />

    {/* CONFIRMACIÓN RSVP */}
    <Rsvp />

    {/* WEDDING FOOTER */}
    <Footer evento={evento} displayDate={displayDate} />

  </main>
</Layout>
