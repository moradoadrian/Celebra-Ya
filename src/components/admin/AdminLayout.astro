---
import '@/styles/global.css';
import AdminNav from './AdminNav.astro';

interface Props {
  title?: string;
  userEmail?: string | null;
}

const { title = 'Panel de Administración | Celebra-Ya', userEmail } = Astro.props;
const currentPath = Astro.url.pathname;
const displayEmail = userEmail || Astro.locals.user?.email || 'Administrador';
---

<!doctype html>
<html lang="es" class="h-full bg-stone-100">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&family=Cormorant+Garamond:wght@600;700&display=swap" rel="stylesheet" />
    <style>
      body {
        font-family: 'Montserrat', sans-serif;
      }
      .font-serif-luxury {
        font-family: 'Cormorant Garamond', Georgia, serif;
      }
    </style>
  </head>
  <body class="h-full antialiased flex flex-col md:flex-row bg-stone-100 text-stone-800">
    
    {/* SIDEBAR OSCURO Y ELEGANTE */}
    <aside class="w-full md:w-64 bg-stone-900 border-b md:border-b-0 md:border-r border-stone-800 shrink-0 flex flex-col justify-between">
      <div>
        {/* LOGO / MARCA TEXTUAL */}
        <div class="p-6 border-b border-stone-800/80">
          <a href="/admin" class="flex items-baseline gap-2 group">
            <span class="font-serif-luxury text-xl font-bold tracking-widest text-amber-200 uppercase">
              CELEBRA-YA
            </span>
            <span class="text-[9px] uppercase tracking-wider bg-amber-400/15 text-amber-300 px-2 py-0.5 rounded-full font-bold border border-amber-400/30">
              ADMIN
            </span>
          </a>
          <p class="text-[10px] text-stone-400 uppercase tracking-widest mt-1">Gestión de Invitaciones</p>
        </div>

        {/* NAVEGACIÓN */}
        <div class="py-6">
          <AdminNav currentPath={currentPath} />
        </div>
      </div>

      {/* FOOTER DEL SIDEBAR */}
      <div class="p-4 border-t border-stone-800 bg-stone-950/50">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 rounded-full bg-amber-500/20 border border-amber-400/30 flex items-center justify-center text-amber-300 text-xs font-bold shrink-0">
            {displayEmail.charAt(0).toUpperCase()}
          </div>
          <div class="overflow-hidden min-w-0">
            <p class="text-[11px] font-semibold text-stone-200 truncate">{displayEmail}</p>
            <span class="text-[9px] text-emerald-400 flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              En línea
            </span>
          </div>
        </div>
      </div>
    </aside>

    {/* ÁREA PRINCIPAL */}
    <div class="flex-1 flex flex-col min-w-0 overflow-y-auto bg-stone-100">
      {/* HEADER LIMPIO */}
      <header class="h-16 border-b border-stone-200 bg-white px-6 sm:px-8 flex items-center justify-between shrink-0 shadow-xs">
        <div class="flex items-center gap-2 text-xs">
          <span class="font-medium text-stone-400">Celebra-Ya</span>
          <span class="text-stone-300">/</span>
          <span class="font-semibold text-stone-800">Panel de Administración</span>
        </div>

        <div class="flex items-center gap-4">
          <a
            href="/demo/boda-sofia-alejandro"
            target="_blank"
            class="text-xs text-stone-600 hover:text-amber-600 transition-colors flex items-center gap-1.5 font-medium"
          >
            <span>Ver demo pública</span>
            <svg width="14" height="14" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
          <div class="h-4 w-px bg-stone-200"></div>
          <a
            href="/admin/logout"
            class="text-xs text-stone-500 hover:text-rose-600 transition-colors flex items-center gap-1 font-medium"
          >
            Salir
          </a>
        </div>
      </header>

      {/* CONTENEDOR PRINCIPAL CLARO */}
      <main class="flex-1 p-6 sm:p-8 md:p-10 max-w-7xl w-full mx-auto">
        <slot />
      </main>
    </div>

  </body>
</html>
