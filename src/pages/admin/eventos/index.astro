---
import AdminLayout from '@/components/admin/AdminLayout.astro';

const user = Astro.locals.user;
const userEmail = user?.email || 'Administrador';
---

<AdminLayout title="Gestión de Eventos | Celebra-Ya" userEmail={userEmail}>
  <div class="space-y-6">
    <div>
      <h1 class="text-2xl sm:text-3xl font-serif-luxury font-bold text-stone-900">
        Gestión de Eventos
      </h1>
      <p class="text-xs text-stone-500 mt-1">
        Listado y administración de invitaciones.
      </p>
    </div>

    <div class="bg-white border border-stone-200/80 rounded-2xl p-8 text-center max-w-xl space-y-4 shadow-xs">
      <div class="w-12 h-12 rounded-xl bg-amber-50 border border-amber-200 flex items-center justify-center text-amber-700 mx-auto text-xl">
        📅
      </div>
      <h2 class="text-base font-semibold text-stone-900">Módulo de Eventos</h2>
      <p class="text-xs text-stone-600 max-w-md mx-auto leading-relaxed">
        Este módulo se activará en el Paso 2 (Dashboard completo y tabla de eventos). La navegación y la autenticación se encuentran plenamente operativas.
      </p>
      <div class="pt-2">
        <a href="/admin" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-stone-100 hover:bg-stone-200 text-stone-800 text-xs font-semibold transition-colors">
          ← Volver al Dashboard
        </a>
      </div>
    </div>
  </div>
</AdminLayout>
