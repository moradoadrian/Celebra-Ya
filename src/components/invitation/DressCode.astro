---
import type { Evento } from '@/types';

interface Props {
  evento?: Evento;
}

const { evento } = Astro.props;

const titulo = evento?.codigo_vestimenta_titulo?.trim() || "Rigurosa Etiqueta / Rigorous Formal";
const caballeros = evento?.codigo_vestimenta_caballeros?.trim() || "Esmoquin o Traje Oscuro.";
const damas = evento?.codigo_vestimenta_damas?.trim() || "Vestido Largo de Noche.";
const notas = evento?.codigo_vestimenta_notas?.trim() || "Reservamos con todo cariño el color blanco e ivory exclusivamente para la novia ✨";
---

<section class="py-20 px-4 max-w-3xl mx-auto text-center border-b border-stone-200/60">
  <div class="bg-white p-10 sm:p-14 rounded-3xl border border-stone-200 shadow-sm space-y-6">
    <span class="text-2xl">👔 👗</span>
    <h2 class="text-3xl font-serif-luxury font-bold text-stone-900">
      Código de Vestimenta
    </h2>
    <div class="inline-block px-5 py-2 rounded-full bg-stone-900 text-amber-200 text-xs font-serif uppercase tracking-widest font-semibold">
      {titulo}
    </div>
    <p class="text-xs sm:text-sm text-stone-600 leading-relaxed font-sans-clean max-w-lg mx-auto">
      <strong>Caballeros:</strong> {caballeros}<br />
      <strong>Damas:</strong> {damas}<br />
      {notas && (
        <span class="italic text-rose-700 mt-2 block font-serif">
          {notas}
        </span>
      )}
    </p>
  </div>
</section>
