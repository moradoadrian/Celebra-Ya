---
import Layout from '@/layouts/Layout.astro';
import { createSupabaseServerClient } from '@/lib/supabase-server';
import { isAdmin } from '@/lib/admin-auth';

let errorMessage = '';

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const email = formData.get('email')?.toString().trim() || '';
    const password = formData.get('password')?.toString() || '';

    if (!email || !password) {
      errorMessage = 'Por favor ingresa tu correo electrónico y contraseña.';
    } else {
      const supabase = createSupabaseServerClient({
        headers: Astro.request.headers,
        cookies: Astro.cookies,
      });

      const { data, error } = await supabase.auth.signInWithPassword({
        email,
        password,
      });

      if (error) {
        errorMessage = 'Credenciales inválidas. Verifica tu correo y contraseña.';
      } else if (data.session && !isAdmin(data.user)) {
        // Credenciales válidas pero sin rol de administrador: no dejar la sesión abierta
        await supabase.auth.signOut();
        errorMessage = 'Tu cuenta no tiene permisos de administrador.';
      } else if (data.session) {
        return Astro.redirect('/admin');
      }
    }
  } catch (e) {
    errorMessage = 'Ocurrió un error inesperado al procesar el inicio de sesión.';
  }
}
---

<Layout title="Acceso Administrativo | Celebra-Ya">
  <main class="min-h-screen bg-stone-50 flex flex-col justify-center items-center px-4 py-12">

    <div class="w-full max-w-md bg-white border border-stone-200 rounded-3xl p-6 sm:p-10 shadow-sm">

      {/* Cabecera */}
      <div class="text-center space-y-3 mb-8">
        <a href="/" class="inline-flex items-center gap-2.5 hover:opacity-90 transition-opacity">
          <span class="w-10 h-10 rounded-xl bg-violet-600 text-white flex items-center justify-center text-lg font-extrabold">C</span>
          <span class="text-xl font-bold text-stone-900">Celebra-Ya</span>
        </a>
        <h1 class="text-2xl font-bold text-stone-900 pt-2">
          ¡Hola de nuevo!
        </h1>
        <p class="text-sm text-stone-500">
          Inicia sesión para gestionar tus eventos e invitaciones.
        </p>
      </div>

      {/* Alerta de Error */}
      {errorMessage && (
        <div class="mb-6 p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm flex items-start gap-3">
          <svg class="w-5 h-5 text-rose-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <span>{errorMessage}</span>
        </div>
      )}

      {/* Formulario Server-Side */}
      <form method="POST" id="login-form" class="space-y-5 text-left">
        <div>
          <label for="email" class="block text-sm text-stone-700 font-semibold mb-1.5">
            Correo electrónico
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            placeholder="tucorreo@ejemplo.com"
            class="w-full px-4 py-3 rounded-xl bg-white border border-stone-300 text-stone-900 text-base sm:text-sm focus:outline-none focus:border-violet-500 focus:ring-4 focus:ring-violet-500/15 transition-all placeholder:text-stone-400"
          />
        </div>

        <div>
          <label for="password" class="block text-sm text-stone-700 font-semibold mb-1.5">
            Contraseña
          </label>
          <input
            type="password"
            id="password"
            name="password"
            required
            autocomplete="current-password"
            placeholder="••••••••"
            class="w-full px-4 py-3 rounded-xl bg-white border border-stone-300 text-stone-900 text-base sm:text-sm focus:outline-none focus:border-violet-500 focus:ring-4 focus:ring-violet-500/15 transition-all placeholder:text-stone-400"
          />
        </div>

        <button
          type="submit"
          id="submit-btn"
          class="w-full py-3.5 px-6 rounded-xl bg-violet-600 hover:bg-violet-700 text-white font-bold text-sm transition-colors flex items-center justify-center gap-2 cursor-pointer mt-2 disabled:opacity-60 disabled:cursor-not-allowed"
        >
          <span id="btn-text">Iniciar sesión</span>
          <svg id="btn-spinner" class="hidden animate-spin w-4 h-4 text-white" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </button>
      </form>

      {/* Pie de página discreto */}
      <div class="mt-8 text-center pt-6 border-t border-stone-100">
        <a href="/" class="text-sm text-stone-500 hover:text-violet-700 transition-colors">
          ← Volver a la página principal
        </a>
      </div>

    </div>
  </main>

  <script>
    const form = document.getElementById('login-form') as HTMLFormElement | null;
    const btn = document.getElementById('submit-btn') as HTMLButtonElement | null;
    const btnText = document.getElementById('btn-text');
    const btnSpinner = document.getElementById('btn-spinner');

    if (form && btn && btnText && btnSpinner) {
      form.addEventListener('submit', () => {
        btn.disabled = true;
        btnText.textContent = 'Verificando...';
        btnSpinner.classList.remove('hidden');
      });
    }
  </script>
</Layout>
