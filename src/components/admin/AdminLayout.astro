---
import '@/styles/global.css';
import AdminNav from './AdminNav.astro';

interface Props {
  title?: string;
  userEmail?: string | null;
}

const { title = 'Panel de Administración | Celebra-Ya', userEmail } = Astro.props;
const currentPath = Astro.url.pathname;
const displayEmail = userEmail || Astro.locals.user?.email || 'Administrador';
---

<!doctype html>
<html lang="es" class="bg-stone-50">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style is:global>
      /* Tipografía del panel: una sola familia sans, cercana y legible */
      body {
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      }
      /* Los títulos del panel usaban una serif de lujo; aquí se muestran con la misma sans en negrita */
      .font-serif-luxury {
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
        letter-spacing: -0.01em;
      }
    </style>
  </head>
  <body class="min-h-screen antialiased bg-stone-50 text-stone-800">

    {/* BARRA SUPERIOR (MÓVIL) */}
    <header class="md:hidden sticky top-0 z-30 h-14 bg-white/95 backdrop-blur border-b border-stone-200 px-4 flex items-center justify-between">
      <a href="/admin" class="flex items-center gap-2">
        <span class="w-8 h-8 rounded-xl bg-violet-600 text-white flex items-center justify-center text-sm font-extrabold">C</span>
        <span class="text-sm font-bold text-stone-900">Celebra-Ya</span>
      </a>
      <button
        type="button"
        id="admin-menu-open"
        aria-label="Abrir menú"
        aria-controls="admin-sidebar"
        aria-expanded="false"
        class="w-10 h-10 -mr-2 rounded-xl flex items-center justify-center text-stone-600 hover:bg-stone-100 cursor-pointer"
      >
        <svg width="22" height="22" class="w-5.5 h-5.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </header>

    {/* FONDO AL ABRIR EL MENÚ EN MÓVIL */}
    <div id="admin-overlay" class="md:hidden fixed inset-0 z-40 bg-stone-900/40 hidden"></div>

    {/* MENÚ LATERAL: cajón en móvil, fijo en escritorio */}
    <aside
      id="admin-sidebar"
      class="fixed inset-y-0 left-0 z-50 w-72 max-w-[85vw] md:w-64 bg-white border-r border-stone-200 flex flex-col -translate-x-full md:translate-x-0 transition-transform duration-200"
    >
      <div class="h-16 px-5 flex items-center justify-between border-b border-stone-100 shrink-0">
        <a href="/admin" class="flex items-center gap-2.5">
          <span class="w-9 h-9 rounded-xl bg-violet-600 text-white flex items-center justify-center text-base font-extrabold">C</span>
          <span>
            <span class="block text-sm font-bold text-stone-900 leading-tight">Celebra-Ya</span>
            <span class="block text-xs text-stone-500 leading-tight">Panel de administración</span>
          </span>
        </a>
        <button
          type="button"
          id="admin-menu-close"
          aria-label="Cerrar menú"
          class="md:hidden w-9 h-9 -mr-2 rounded-xl flex items-center justify-center text-stone-500 hover:bg-stone-100 cursor-pointer"
        >
          <svg width="20" height="20" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div class="flex-1 overflow-y-auto py-4">
        <AdminNav currentPath={currentPath} />
      </div>

      {/* USUARIO */}
      <div class="p-4 border-t border-stone-100 shrink-0">
        <div class="flex items-center gap-3 p-2 rounded-2xl bg-stone-50">
          <div class="w-9 h-9 rounded-full bg-violet-100 text-violet-700 flex items-center justify-center text-sm font-bold shrink-0">
            {displayEmail.charAt(0).toUpperCase()}
          </div>
          <div class="min-w-0 flex-1">
            <p class="text-xs font-semibold text-stone-800 truncate">{displayEmail}</p>
            <p class="text-xs text-stone-500">Administrador</p>
          </div>
        </div>
      </div>
    </aside>

    {/* ÁREA PRINCIPAL */}
    <div class="md:pl-64 min-h-screen flex flex-col">
      {/* BARRA SUPERIOR (ESCRITORIO) */}
      <header class="hidden md:flex h-16 px-8 items-center justify-end gap-2 bg-white border-b border-stone-200 shrink-0">
        <a
          href="/demo/boda-sofia-alejandro"
          target="_blank"
          class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-sm font-medium text-stone-600 hover:text-violet-700 hover:bg-violet-50 transition-colors"
        >
          <span>Ver demo pública</span>
          <svg width="14" height="14" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </header>

      <main class="flex-1 w-full max-w-7xl mx-auto px-4 py-5 sm:px-6 sm:py-6 lg:px-8 lg:py-8">
        <slot />
      </main>
    </div>

    <script is:inline>
      (() => {
        const sidebar = document.getElementById('admin-sidebar');
        const overlay = document.getElementById('admin-overlay');
        const openBtn = document.getElementById('admin-menu-open');
        const closeBtn = document.getElementById('admin-menu-close');
        if (!sidebar || !overlay || !openBtn || !closeBtn) return;

        const setOpen = (open) => {
          sidebar.classList.toggle('-translate-x-full', !open);
          overlay.classList.toggle('hidden', !open);
          openBtn.setAttribute('aria-expanded', String(open));
          document.body.classList.toggle('overflow-hidden', open);
        };

        openBtn.addEventListener('click', () => setOpen(true));
        closeBtn.addEventListener('click', () => setOpen(false));
        overlay.addEventListener('click', () => setOpen(false));
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') setOpen(false);
        });
      })();
    </script>
  </body>
</html>
